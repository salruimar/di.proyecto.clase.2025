<mah:MetroWindow x:Class="di.proyecto.clase._2025.Frontend.Dialogos.DialogoUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:di.proyecto.clase._2025.Frontend.Dialogos"
        mc:Ignorable="d"
        Title="DialogoUsuario" Height="450" Width="800" Loaded="MetroWindow_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>


        <Grid Grid.ColumnSpan="2" Background="Purple">
            <TextBlock Text="AÑADIR USUARIO" Foreground="White" HorizontalAlignment="Center" FontSize="25" Margin="20"/>
        </Grid>

        <TextBlock Text="Los campos en negrita son obligatorios" FontWeight="Bold" FontSize="15" Grid.Row="1"/>

        <TextBlock Text="Nombre de usuario: " FontSize="15"  Grid.Row="2" Margin="20,10,0,0"/>
        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" x:Name="txtUsername" Grid.Row="3" Margin="20,0,10,0"
         Text="{Binding usuario.Username,
         ValidatesOnDataErrors=True, NotifyOnValidationError=True,
         UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Contraseña: " FontSize="15"  Grid.Row="2" Grid.Column="1" Margin="20,10,0,0"/>
        
        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" x:Name="txtPassword" Grid.Row="3" 
         Grid.Column="1" Margin="20,0,10,0" Text="{Binding usuario.Password,
         ValidatesOnDataErrors=True, NotifyOnValidationError=True,
         UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Tipo de usuario: " FontSize="15"  Grid.Row="4" Margin="20,10,0,0"/>
        <ComboBox Grid.Row="5" DisplayMemberPath="Nombre" mat:HintAssist.Hint="Selecciona un espacio"
          ItemsSource="{Binding listaTiposUsuarios}" Margin="20,10,0,0" x:Name="cmbTipo"
          Style="{StaticResource MaterialDesignOutlinedComboBox}"
          SelectedItem="{Binding usuario.TipoNavegacion,
         ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>


        <TextBlock Text="Rol del usuario: " FontSize="15"  Grid.Row="4" Grid.Column="1" Margin="20,10,0,0"/>
        <ComboBox Grid.Row="5" Grid.Column="1" DisplayMemberPath="Nombre" mat:HintAssist.Hint="Selecciona un espacio"
          ItemsSource="{Binding listaRoles}" Margin="20,10,0,0" x:Name="cmbRol"
          Style="{StaticResource MaterialDesignOutlinedComboBox}"
          SelectedItem="{Binding usuario.RolNavegacion,
         ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>

        <Button x:Name="btnCancelarUsuario" 
            Content="CANCELAR"
            Margin="20,0,220,0"
            Style="{StaticResource MaterialDesignRaisedButton}"
            Background="White"
            Foreground="#2B2A4C"
            Grid.Row="6" Grid.Column="1" Click="btnCancelarUsuario_Click" />

        <Button x:Name="btnGuardarUsuario" 
            Content="GUARDAR"
            Margin="220,0,10,0"
            Style="{StaticResource MaterialDesignRaisedButton}"
            Background="Indigo"
            Foreground="White"
            Grid.Row="6" Grid.Column="1" Click="btnGuardarUsuario_Click"  />

    </Grid>
</mah:MetroWindow>
