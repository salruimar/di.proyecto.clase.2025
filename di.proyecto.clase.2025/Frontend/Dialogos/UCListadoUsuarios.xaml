<UserControl x:Class="di.proyecto.clase._2025.Frontend.Dialogos.UCListadoUsuarios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:di.proyecto.clase._2025.Frontend.Dialogos"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <TextBlock Text="LISTADO DE USUARIOS" 
                       FontSize="25" FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="20"
                       Foreground="Purple"/>
        </Grid>
        <Grid>
            <DataGrid ItemsSource="{Binding listaUsuarios}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      ColumnWidth="*">
                <DataGrid.Columns>
                    <!-- Nombre y apellidos, username, tipo - rol, departamento, grupo, nºarticulos de alta -->
                    <DataGridTextColumn Binding="{Binding}">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <mat:PackIcon Kind="BusinessCardOutline"/>
                                <TextBlock Text="DATOS PERSONALES"/>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Username}">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <mat:PackIcon Kind="AccountCircleOutline"/>
                                <TextBlock Text="NOBRE DE USUARIO"/>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <mat:PackIcon Kind="FrenchBaguette"/>
                                <TextBlock Text="TIPO - ROL"/>
                            </StackPanel>
                        </DataGridTemplateColumn.Header>

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="1*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Tipo"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TipoNavigation.Nombre}"/>

                                    <TextBlock Text="Rol" Grid.Row="1"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RolNavigation.Nombre}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Binding="{Binding DepartamentoNavigation.Nombre}">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <mat:PackIcon Kind="Graph"/>
                                <TextBlock Text="DEPARTAMENTO"/>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding GrupoNavigation.Nombre}">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <mat:PackIcon Kind="AccountGroupOutline"/>
                                <TextBlock Text="GRUPO"/>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding ArticuloUsuarioaltaNavigations.Count}">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <mat:PackIcon Kind="Barcode"/>
                                <TextBlock Text="NºArtículosAlta"/>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>

