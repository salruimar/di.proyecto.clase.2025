<UserControl x:Class="di.proyecto.clase._2025.Frontend.Dialogos.UCListadoModelos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:di.proyecto.clase._2025.Frontend.Dialogos"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="LISTADO DE MODELOS DE ARTÍCULO" 
        FontSize="25" FontWeight="Bold" 
        HorizontalAlignment="Center" 
        Margin="20"
        Foreground="Purple"/>

            <StackPanel Orientation="Horizontal" Grid.Row="1">
                <TextBlock Text="FILTROS" Margin="10" VerticalAlignment="Center" Foreground="Black"/>
                <TextBlock Text="Por  tipo de artículo" Margin="10,10,5,10" VerticalAlignment="Center" Foreground="Black"/>
                <ComboBox DisplayMemberPath="Nombre"
               ItemsSource="{Binding listaTiposArticulos}"
               SelectedItem="{Binding tipoArticuloSeleccionado}"
               Style="{StaticResource MaterialDesignOutlinedComboBox}"
               Margin="0,10,10,10"
               Width="200" SelectionChanged="cbTipoArticulo_SelectionChanged"
                          x:Name="cbTipoArticulo"
                          Foreground="Black"/>

                <Button Content="X"
                        Margin="10"
                        x:Name="btnLimpiarFiltros"
                        Click="btnLimpiarFiltros_Click"
                        Style="{StaticResource MahApps.Styles.Button}"
                        Background="#2B2A4C"
                        Foreground="White"/>
                
            </StackPanel>
        </Grid>
        <Grid>
            <DataGrid ItemsSource="{Binding listaModelosArticulos}"
                      IsReadOnly="True"
                      SelectedItem="{Binding modeloArticulo}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      ColumnWidth="*">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOMBRE DEL MODELO" Binding="{Binding Nombre}"/>
                    <DataGridTemplateColumn Header="MARCA - MODELO" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" >
                                    <TextBlock Text="{Binding Marca}" FontWeight="Bold"/>
                                    <TextBlock Text=" - " />
                                    <TextBlock Text="{Binding Modelo}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="CANTIDAD DE ARTÍCULOS" Binding="{Binding Articulos.Count}"/>
                    <DataGridTextColumn Header="TIPO DE ARTÍCULO" Binding="{Binding TipoNavigation.Nombre}"/>
                    <DataGridTextColumn Header="DESCRIPCION" Binding="{Binding Descripcion}"/>
                    
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Editar Modelo" Click="EditarModelo_Click">
                            <MenuItem.Icon>
                                <Image Source="/Recursos/Iconos/editar.png" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="Eliminar Modelo" Click="EliminarModelo_Click">
                            <MenuItem.Icon>
                                <Image Source="/Recursos/Iconos/borrar.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
